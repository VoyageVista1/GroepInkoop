<bpmn:sequenceFlow id="sf_f17" sourceRef="s1" targetRef="gs"/>
<bpmn:sequenceFlow id="sf_f18" name="Nee, terug" sourceRef="gs" targetRef="m8"/>
<bpmn:sequenceFlow id="sf_f19" name="Ja" sourceRef="gs" targetRef="gm2"/>
<bpmn:sequenceFlow id="sf_f20" sourceRef="gm2" targetRef="m10"/>
<bpmn:sequenceFlow id="sf_f21" sourceRef="m10" targetRef="m11"/>
