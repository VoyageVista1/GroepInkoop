<bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Klantenservice">
<bpmndi:BPMNShape id="P_klant_di" bpmnElement="P_klant" isHorizontal="true"><dc:Bounds x="20" y="70" width="4210" height="192"/></bpmndi:BPMNShape>
