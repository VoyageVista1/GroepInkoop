<bpmn:sequenceFlow id="sf_f24" name="Nee (bezwaar)" sourceRef="gw4" targetRef="a1"/>
<bpmn:sequenceFlow id="sf_f25" sourceRef="a1" targetRef="a2"/>
<bpmn:sequenceFlow id="sf_f26" sourceRef="a2" targetRef="f1"/>
<bpmn:sequenceFlow id="sf_f27" sourceRef="f1" targetRef="f2"/>
<bpmn:sequenceFlow id="sf_f28" sourceRef="f2" targetRef="f_end"/>
<bpmn:dataStoreReference id="ds" name="Klantdossier (werkplek)"/>
<bpmn:dataObjectReference id="do" name="Compensatierichtlijn (% van reissom)" dataObjectRef="do_obj"/><bpmn:dataObject id="do_obj"/>
</bpmn:process>
