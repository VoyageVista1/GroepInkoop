<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Klantenservice" targetNamespace="https://github.com/VoyageVista1/GroepInkoop" exporter="GroepInkoop" exporterVersion="1.0">
<bpmn:collaboration id="Collab_Klantenservice">
<bpmn:participant id="P_klant" name="Klant" processRef="Proc_klant"/>
<bpmn:participant id="P_vv" name="VoyageVista" processRef="Proc_vv"/>
<bpmn:participant id="P_lev" name="Leverancier (hotel op de bestemming)"/>
<bpmn:messageFlow id="mf1" name="Vraag of klacht" sourceRef="k1" targetRef="ms"/>
<bpmn:messageFlow id="mf2" name="Antwoord" sourceRef="me1" targetRef="k2"/>
<bpmn:messageFlow id="mf3" name="Besluit of voorstel" sourceRef="m10" targetRef="k2"/>
<bpmn:messageFlow id="mf4" name="Akkoord of bezwaar" sourceRef="k3" targetRef="m11"/>
<bpmn:messageFlow id="mf5" name="Eindbesluit" sourceRef="a2" targetRef="k4"/>
<bpmn:messageFlow id="mf6" name="Rekeningnummer via Mijn VoyageVista" sourceRef="k5" targetRef="f1"/>
<bpmn:messageFlow id="mf7" name="Verzoek om oplossing" sourceRef="m5" targetRef="P_lev"/>
<bpmn:messageFlow id="mf8" name="Reactie hotel" sourceRef="P_lev" targetRef="m5"/>
</bpmn:collaboration>
<bpmn:process id="Proc_klant" isExecutable="false">
<bpmn:startEvent id="k_start" name="Klant heeft vraag of klacht"><bpmn:outgoing>sf_fk1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="k1" name="Neemt contact op (telefoon, e-mail, shop, social media)"><bpmn:incoming>sf_fk1</bpmn:incoming><bpmn:outgoing>sf_fk2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="k2" name="Ontvangt antwoord of voorstel"><bpmn:incoming>sf_fk2</bpmn:incoming><bpmn:outgoing>sf_fk3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="k3" name="Reageert op voorstel (akkoord of bezwaar)"><bpmn:incoming>sf_fk3</bpmn:incoming><bpmn:outgoing>sf_fk4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="k4" name="Ontvangt eindbesluit"><bpmn:incoming>sf_fk4</bpmn:incoming><bpmn:outgoing>sf_fk5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="k5" name="Vult zelf rekeningnummer in"><bpmn:documentation>Verbetering 5: De klant vult zelf het rekeningnummer in. VoyageVista slaat het nergens op.</bpmn:documentation><bpmn:incoming>sf_fk5</bpmn:incoming><bpmn:outgoing>sf_fk6</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="k_end" name="Klant geholpen"><bpmn:incoming>sf_fk6</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="sf_fk1" sourceRef="k_start" targetRef="k1"/>
<bpmn:sequenceFlow id="sf_fk2" sourceRef="k1" targetRef="k2"/>
<bpmn:sequenceFlow id="sf_fk3" sourceRef="k2" targetRef="k3"/>
<bpmn:sequenceFlow id="sf_fk4" sourceRef="k3" targetRef="k4"/>
<bpmn:sequenceFlow id="sf_fk5" sourceRef="k4" targetRef="k5"/>
<bpmn:sequenceFlow id="sf_fk6" sourceRef="k5" targetRef="k_end"/>
</bpmn:process>
<bpmn:process id="Proc_vv" isExecutable="false"><bpmn:laneSet id="LaneSet_vv">
<bpmn:lane id="L_ks" name="Klantenservice (shop en contactcenter)"><bpmn:flowNodeRef>ms</bpmn:flowNodeRef><bpmn:flowNodeRef>m1</bpmn:flowNodeRef><bpmn:flowNodeRef>m2</bpmn:flowNodeRef><bpmn:flowNodeRef>gw1</bpmn:flowNodeRef><bpmn:flowNodeRef>m3</bpmn:flowNodeRef><bpmn:flowNodeRef>me1</bpmn:flowNodeRef><bpmn:flowNodeRef>m4</bpmn:flowNodeRef><bpmn:flowNodeRef>gw2</bpmn:flowNodeRef><bpmn:flowNodeRef>m5</bpmn:flowNodeRef><bpmn:flowNodeRef>gm1</bpmn:flowNodeRef><bpmn:flowNodeRef>m6</bpmn:flowNodeRef><bpmn:flowNodeRef>gw3</bpmn:flowNodeRef><bpmn:flowNodeRef>m7</bpmn:flowNodeRef><bpmn:flowNodeRef>m8</bpmn:flowNodeRef><bpmn:flowNodeRef>gm2</bpmn:flowNodeRef><bpmn:flowNodeRef>m10</bpmn:flowNodeRef><bpmn:flowNodeRef>m11</bpmn:flowNodeRef><bpmn:flowNodeRef>gw4</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_sr" name="Senior klantenservice"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>gs</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_at" name="After Travel"><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_fi" name="Financiën &amp; Administratie"><bpmn:flowNodeRef>f1</bpmn:flowNodeRef><bpmn:flowNodeRef>f2</bpmn:flowNodeRef><bpmn:flowNodeRef>f_end</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ms" name="Contact ontvangen"><bpmn:outgoing>sf_f1</bpmn:outgoing><bpmn:messageEventDefinition id="ms_med"/></bpmn:startEvent>
<bpmn:userTask id="m1" name="Klant zoeken (e-mail, telefoon, naam)"><bpmn:incoming>sf_f1</bpmn:incoming><bpmn:outgoing>sf_f2</bpmn:outgoing><bpmn:property id="m1_prop" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="as1"><bpmn:sourceRef>ds</bpmn:sourceRef><bpmn:targetRef>m1_prop</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:userTask id="m2" name="Contactmoment vastleggen in klantdossier"><bpmn:documentation>Verbetering 1: Contactmoment vastleggen met vaste velden (kanaal, categorie, samenvatting, vervolgactie) in plaats van één vrij opmerkingenveld. Datum en medewerker vult het systeem zelf in.</bpmn:documentation><bpmn:incoming>sf_f2</bpmn:incoming><bpmn:outgoing>sf_f3</bpmn:outgoing><bpmn:dataOutputAssociation id="as2"><bpmn:targetRef>ds</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="gw1" name="Soort contact?"><bpmn:incoming>sf_f3</bpmn:incoming><bpmn:outgoing>sf_f4</bpmn:outgoing><bpmn:outgoing>sf_f6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="m3" name="Vraag beantwoorden of wijziging verwerken"><bpmn:incoming>sf_f4</bpmn:incoming><bpmn:outgoing>sf_f5</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="me1" name="Vraag afgehandeld"><bpmn:incoming>sf_f5</bpmn:incoming><bpmn:messageEventDefinition id="me1_med"/></bpmn:endEvent>
<bpmn:userTask id="m4" name="Klacht registreren (urgentie automatisch)"><bpmn:documentation>Verbetering 2: De urgentie wordt automatisch Hoog als de klant op dat moment op reis is.</bpmn:documentation><bpmn:incoming>sf_f6</bpmn:incoming><bpmn:outgoing>sf_f7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw2" name="Klant nu op reis?"><bpmn:incoming>sf_f7</bpmn:incoming><bpmn:outgoing>sf_f8</bpmn:outgoing><bpmn:outgoing>sf_f9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="m5" name="Hotel vragen om oplossing ter plaatse"><bpmn:documentation>Verbetering 3: Bij een klant op reis vraagt de medewerker eerst het hotel om een oplossing ter plaatse.</bpmn:documentation><bpmn:incoming>sf_f8</bpmn:incoming><bpmn:outgoing>sf_f10</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gm1"><bpmn:incoming>sf_f9</bpmn:incoming><bpmn:incoming>sf_f10</bpmn:incoming><bpmn:outgoing>sf_f11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="m6" name="Klacht beoordelen (historie, zelf gekozen?)"><bpmn:documentation>Verbetering 4: De klacht wordt beoordeeld met de volledige klanthistorie, inclusief of de klant de accommodatie zelf koos.</bpmn:documentation><bpmn:incoming>sf_f11</bpmn:incoming><bpmn:outgoing>sf_f12</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw3" name="Klacht gegrond?"><bpmn:incoming>sf_f12</bpmn:incoming><bpmn:outgoing>sf_f13</bpmn:outgoing><bpmn:outgoing>sf_f14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="m7" name="Ongegrond verklaren met onderbouwing"><bpmn:incoming>sf_f14</bpmn:incoming><bpmn:outgoing>sf_f15</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="m8" name="Compensatie-voorstel volgens richtlijn"><bpmn:incoming>sf_f13</bpmn:incoming><bpmn:incoming>sf_f18</bpmn:incoming><bpmn:outgoing>sf_f16</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gm2"><bpmn:incoming>sf_f15</bpmn:incoming><bpmn:incoming>sf_f19</bpmn:incoming><bpmn:outgoing>sf_f20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="m10" name="Klant informeren over besluit of voorstel"><bpmn:incoming>sf_f20</bpmn:incoming><bpmn:outgoing>sf_f21</bpmn:outgoing></bpmn:userTask>
<bpmn:receiveTask id="m11" name="Reactie klant verwerken"><bpmn:incoming>sf_f21</bpmn:incoming><bpmn:outgoing>sf_f22</bpmn:outgoing></bpmn:receiveTask>
<bpmn:exclusiveGateway id="gw4" name="Klant akkoord?"><bpmn:incoming>sf_f22</bpmn:incoming><bpmn:outgoing>sf_f23</bpmn:outgoing><bpmn:outgoing>sf_f24</bpmn:outgoing></bpmn:exclusiveGateway>

<bpmn:userTask id="s1" name="Voorstel controleren (vier ogen)"><bpmn:documentation>Verbetering 6: Een tweede medewerker keurt het compensatievoorstel goed. Wie het voorstel indient, mag het niet zelf goedkeuren.</bpmn:documentation><bpmn:incoming>sf_f16</bpmn:incoming><bpmn:outgoing>sf_f17</bpmn:outgoing><bpmn:property id="s1_prop" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="as3"><bpmn:sourceRef>do</bpmn:sourceRef><bpmn:targetRef>s1_prop</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="gs" name="Goed-gekeurd?"><bpmn:incoming>sf_f17</bpmn:incoming><bpmn:outgoing>sf_f18</bpmn:outgoing><bpmn:outgoing>sf_f19</bpmn:outgoing></bpmn:exclusiveGateway>

<bpmn:userTask id="a1" name="Klacht opnieuw beoordelen (maatwerk)"><bpmn:incoming>sf_f24</bpmn:incoming><bpmn:outgoing>sf_f25</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="a2" name="Eindbesluit vastleggen en communiceren"><bpmn:incoming>sf_f25</bpmn:incoming><bpmn:outgoing>sf_f26</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="f1" name="Compensatie uitbetalen (indien van toepassing)"><bpmn:incoming>sf_f23</bpmn:incoming><bpmn:incoming>sf_f26</bpmn:incoming><bpmn:outgoing>sf_f27</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="f2" name="Klachtdossier afsluiten"><bpmn:incoming>sf_f27</bpmn:incoming><bpmn:outgoing>sf_f28</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="f_end" name="Klacht afgehandeld"><bpmn:incoming>sf_f28</bpmn:incoming></bpmn:endEvent>
